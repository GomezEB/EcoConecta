# Copiar como .env; NO subir ese archivo a GitHub.
POSTGRES_DB=ecoconecta
POSTGRES_USER=ecoconecta
POSTGRES_PASSWORD=CAMBIAR_POR_CONTRASENA_LARGA
DATABASE_URL=postgresql+psycopg://ecoconecta:CAMBIAR_POR_CONTRASENA_LARGA@db:5432/ecoconecta
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
SESSION_HOURS=12
PILOTO_ABIERTO=false
# En Meta Developer: el ID corresponde al Phone Number ID de tu app de prueba.
# El número receptor que inicia el chat debe estar permitido en la lista de pruebas de Meta.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v23.0
# Opcional: solo usar modelos autorizados y no enviar datos personales.
OPENAI_API_KEY=
